{
  "name": "qvac-pocket-tune",
  "version": "0.2.0",
  "description": "Fine-tune a personal LoRA adapter on your own notes and chats, entirely on-device with Tether QVAC, and share it peer-to-peer.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/core.js"
  },
  "bin": {
    "pocket-tune": "bin/pocket-tune.js"
  },
  "files": [
    "bin",
    "src",
    "ui/dist",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/pocket-tune.js ui",
    "test": "node --test --test-timeout=30000",
    "build:ui": "npm --prefix ui ci && npm --prefix ui run build",
    "dev:ui": "npm --prefix ui run dev",
    "prepack": "npm run build:ui"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "qvac",
    "tether",
    "lora",
    "fine-tuning",
    "on-device",
    "local-ai",
    "privacy"
  ],
  "author": "lopeselio",
  "license": "Apache-2.0",
  "homepage": "https://github.com/lopeselio/qvac-pocket-tune#readme",
  "bugs": {
    "url": "https://github.com/lopeselio/qvac-pocket-tune/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lopeselio/qvac-pocket-tune.git"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@qvac/sdk": "^0.23.0",
    "@scure/bip39": "^2.4.0",
    "qvac-seed": "^0.1.0"
  }
}
